# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signing key for invitation and check-in tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SIGNING_SECRET=

# Base URL used when minting promoter-facing links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required before publishing the waitlist privacy policy.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Anthropic — only used for NL query translation and report summarisation
ANTHROPIC_API_KEY=

# Messaging adapter: clipboard | telegram | whatsapp
# clipboard is the default and needs no credentials
MESSAGING_ADAPTER=clipboard
TELEGRAM_BOT_TOKEN=
